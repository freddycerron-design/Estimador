# InsForge backend
INSFORGE_BASE_URL=https://swm8ne4y.us-east.insforge.app
INSFORGE_ANON_KEY=
# Admin/service key with elevated privileges (server-side only, never exposed to frontend)
INSFORGE_SERVICE_KEY=

# OpenRouter (provisioned via InsForge Model Gateway) — used server-side only
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM provider selection (see apps/backend/src/llm/provider-factory.ts)
LLM_PROVIDER=openrouter
LLM_MODEL_ORCHESTRATOR=anthropic/claude-sonnet-5
LLM_MODEL_LEARNING_AGENT=anthropic/claude-opus-5
LLM_MODEL_EMBEDDING=

# Backend
PORT=4000
NODE_ENV=development
